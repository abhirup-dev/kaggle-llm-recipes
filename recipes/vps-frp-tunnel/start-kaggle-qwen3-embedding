#!/bin/zsh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
FRP_SECRET_FILE="$ROOT_DIR/.secrets/vps-frp.env"
HF_SECRET_FILE="$ROOT_DIR/.secrets/huggingface.env"
KAGGLE_SECRET_FILE="${1:-$ROOT_DIR/.secrets/kaggle-codebuddha.env}"
export KAGGLE_CONFIG_DIR="${KAGGLE_CONFIG_DIR:-$ROOT_DIR/.secrets/kaggle-codebuddha-oauth}"
KAGGLE_OWNER="${2:-codebuddha}"
REQUESTED_FRP_REMOTE_PORT="${3:-19103}"
REQUESTED_FRP_PROXY_NAME="${4:-${KAGGLE_OWNER}-qwen3-embedding-4b}"
CTX_SIZE="${5:-32768}"
BATCH_SIZE="${6:-8192}"
UBATCH_SIZE="${7:-8192}"
PARALLEL="${8:-1}"
VPS_HOST="${VPS_HOST:-vpsgtw}"
KAGGLE_SLUG="${KAGGLE_SLUG:-llama-cpp-qwen3-embedding-4b-q4-server}"
KAGGLE_REF="${KAGGLE_OWNER}/${KAGGLE_SLUG}"

for value in "$REQUESTED_FRP_REMOTE_PORT" "$CTX_SIZE" "$BATCH_SIZE" "$UBATCH_SIZE" "$PARALLEL"; do
  [[ "$value" == <-> && "$value" -gt 0 ]] || {
    echo "Ports, context, batch sizes, and parallel count must be positive integers" >&2
    exit 2
  }
done
[[ -f "$FRP_SECRET_FILE" ]] || { echo "Missing $FRP_SECRET_FILE" >&2; exit 1; }
[[ -f "$HF_SECRET_FILE" ]] || { echo "Missing $HF_SECRET_FILE" >&2; exit 1; }
[[ -f "$KAGGLE_SECRET_FILE" ]] || { echo "Missing $KAGGLE_SECRET_FILE" >&2; exit 1; }

set -a
source "$FRP_SECRET_FILE"
source "$HF_SECRET_FILE"
source "$KAGGLE_SECRET_FILE"
set +a

: "${FRP_SERVER_ADDR:?missing FRP_SERVER_ADDR}"
: "${FRP_AUTH_TOKEN:?missing FRP_AUTH_TOKEN}"
: "${HF_TOKEN:?missing HF_TOKEN}"
export FRP_SERVER_PORT="${FRP_SERVER_PORT:-7443}"
FRP_REMOTE_PORT="$REQUESTED_FRP_REMOTE_PORT"
FRP_PROXY_NAME="$REQUESTED_FRP_PROXY_NAME"
export FRP_PROXY_NAME FRP_REMOTE_PORT
export FRP_LOCAL_ADDR="127.0.0.1"
export FRP_LOCAL_PORT="8080"
export LOG_RELAY_HOST="${LOG_RELAY_HOST:-$FRP_SERVER_ADDR}"
export LOG_RELAY_PORT="${LOG_RELAY_PORT:-24224}"
export LOG_WORKER_ID="${KAGGLE_OWNER}-${KAGGLE_SLUG}"
export LOG_RELAY_ENABLED="${LOG_RELAY_ENABLED:-1}"
case "$LOG_RELAY_ENABLED" in
  1)
    export LOG_RELAY_CA_PEM="$(ssh "$VPS_HOST" "cat /home/abhirup/kaggle-log-relay/certs/ca.crt")"
    export LOG_RELAY_SHARED_KEY="$(
      python3 -c 'import hashlib, hmac, os; print(hmac.new(
        os.environ["FRP_AUTH_TOKEN"].encode(),
        b"kaggle-log-relay/v1",
        hashlib.sha256,
      ).hexdigest())'
    )"
    ;;
  0)
    export LOG_RELAY_CA_PEM=""
    export LOG_RELAY_SHARED_KEY=""
    ;;
  *)
    echo "LOG_RELAY_ENABLED must be 0 or 1" >&2
    exit 2
    ;;
esac
export KAGGLE_OWNER KAGGLE_SLUG CTX_SIZE BATCH_SIZE UBATCH_SIZE PARALLEL

"$SCRIPT_DIR/stop-kaggle-kernel" "$KAGGLE_REF"

kernel_dir="$(mktemp -d)"
trap 'rm -rf "$kernel_dir"' EXIT

python3 - \
  "$SCRIPT_DIR/frp_tunnel.py" \
  "$SCRIPT_DIR/observability.py" \
  "$ROOT_DIR/recipes/llama-cpp-qwen3-embedding-4b-q4/server.py" \
  "$ROOT_DIR/recipes/llama-cpp-qwen3-embedding-4b-q4/kernel-metadata.json" \
  "$kernel_dir/server.py" \
  "$kernel_dir/kernel-metadata.json" <<'PY'
import json
import os
import pathlib
import sys

tunnel_path, observability_path, server_path, metadata_path, output_server, output_metadata = map(
    pathlib.Path, sys.argv[1:]
)
tunnel = tunnel_path.read_text().split("\nif __name__ == \"__main__\":", 1)[0]
observability = observability_path.read_text().split(
    "\nif __name__ == \"__main__\":", 1
)[0].replace("from __future__ import annotations\n", "")
server = server_path.read_text()
replacements = {
    "__HF_TOKEN__": os.environ["HF_TOKEN"],
    "__CTX_SIZE__": os.environ["CTX_SIZE"],
    "__BATCH_SIZE__": os.environ["BATCH_SIZE"],
    "__UBATCH_SIZE__": os.environ["UBATCH_SIZE"],
    "__PARALLEL__": os.environ["PARALLEL"],
}
for placeholder, value in replacements.items():
    server = server.replace(placeholder, value)
if any(placeholder in server for placeholder in replacements):
    raise SystemExit("kernel template placeholder was not replaced")

runtime = {
    name: os.environ[name]
    for name in (
        "FRP_SERVER_ADDR",
        "FRP_SERVER_PORT",
        "FRP_AUTH_TOKEN",
        "FRP_PROXY_NAME",
        "FRP_LOCAL_ADDR",
        "FRP_LOCAL_PORT",
        "FRP_REMOTE_PORT",
        "LOG_RELAY_HOST",
        "LOG_RELAY_PORT",
        "LOG_RELAY_SHARED_KEY",
        "LOG_RELAY_CA_PEM",
        "LOG_WORKER_ID",
        "LOG_RELAY_ENABLED",
    )
}
server = server.replace("import time\n", "import time\nimport threading\n", 1)
server = server.replace(
    'mark("dependencies_ready")',
    f"""\
os.environ.update({runtime!r})
log_relay_enabled = os.environ["LOG_RELAY_ENABLED"] == "1"
install_observability(log_relay_enabled)
logger = configure_logger()
fluent_bit = fluent_bit_log = resource_sampler_stop = None
emit(logger, "worker_starting", worker_id=os.environ["LOG_WORKER_ID"])
mark("dependencies_ready")""",
    1,
)
server = server.replace(
    'log = open("/kaggle/working/llama-server.log", "w")',
    """\
log = open("/kaggle/working/llama-server.log", "w")
if log_relay_enabled:
    fluent_bit, fluent_bit_log = start_fluent_bit(os.environ["LOG_WORKER_ID"])
    emit(
        logger,
        "log_relay_started",
        relay_host=os.environ["LOG_RELAY_HOST"],
        relay_port=int(os.environ["LOG_RELAY_PORT"]),
    )
else:
    emit(logger, "log_relay_disabled")""",
    1,
)
server = server.replace(
    "for _ in range(900):",
    """\
resource_sampler_stop = start_resource_sampler(logger, server.pid)

for _ in range(900):""",
    1,
)
server = server.replace(
    'mark("tunnel_ready", transport="local")',
    f"""\
os.environ.update({runtime!r})
tunnel_config = TunnelConfig.from_env()
verify_public_ingress(tunnel_config)
tunnel_thread = threading.Thread(target=run, args=(tunnel_config,), daemon=True)
tunnel_thread.start()
mark("tunnel_ready", transport="frp", remote_port=tunnel_config.remote_port)""",
    1,
)
server = server.replace(
    "finally:\n    server.terminate()\n    log.close()",
    """\
finally:
    if resource_sampler_stop:
        resource_sampler_stop.set()
    if fluent_bit:
        fluent_bit.terminate()
    if fluent_bit_log:
        fluent_bit_log.close()
    server.terminate()
    log.close()""",
    1,
)
output_server.write_text(tunnel + "\n\n" + observability + "\n\n" + server)

metadata = json.loads(metadata_path.read_text())
metadata["id"] = f"{os.environ['KAGGLE_OWNER']}/{os.environ['KAGGLE_SLUG']}"
metadata["title"] = os.environ["KAGGLE_SLUG"].replace("-", " ")
output_metadata.write_text(json.dumps(metadata))
PY

python3 "$SCRIPT_DIR/frp_tunnel.py" --self-test
python3 "$SCRIPT_DIR/observability.py"
python3 -m py_compile \
  "$ROOT_DIR/recipes/llama-cpp-qwen3-embedding-4b-q4/server.py" \
  "$SCRIPT_DIR/verify_embedding_api.py" \
  "$kernel_dir/server.py"
kaggle kernels push -p "$kernel_dir" --accelerator NvidiaTeslaT4 --timeout 43200
echo "Pushed $KAGGLE_REF"
